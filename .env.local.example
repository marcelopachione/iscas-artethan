# ============================================================
# Sistema de iscas — suas configurações
# ============================================================
# Como usar: copie este arquivo com o nome .env.local (comando: cp .env.local.example .env.local)
# e preencha cada linha. O .env.local fica SÓ na sua máquina e nunca vai pro GitHub.
# Na Vercel, você cadastra as mesmas linhas em Settings → Environment Variables.
#
# Depois de mudar qualquer coisa aqui, pare o `npm run dev` (Ctrl+C) e rode de novo.

# ------------------------------------------------------------
# 1. QUEM É VOCÊ (aparece no topo de todas as páginas)
# ------------------------------------------------------------
# Seu nome, do jeito que aparece no seu perfil
NEXT_PUBLIC_AUTHOR_NAME=Seu Nome
# Seu @ do Instagram (com ou sem o @)
NEXT_PUBLIC_AUTHOR_HANDLE=@seuperfil
# Selo azul de verificado ao lado do nome: true (mostra) ou false (esconde)
NEXT_PUBLIC_VERIFIED=false
# A foto de perfil NÃO fica aqui: troque o arquivo public/avatar.jpg pela sua foto do Instagram
# (quadrada, com o mesmo nome avatar.jpg).

# ------------------------------------------------------------
# 2. BANCO DE DADOS (Supabase) — onde os contatos ficam guardados
# ------------------------------------------------------------
# Onde pegar: o Claude grava sozinho pela linha de comando (supabase projects api-keys).
# Na mão: supabase.com → seu projeto → Project Settings → API
# URL do projeto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxx.supabase.co
# Chave "anon public". Pode aparecer no navegador: ela só consegue GRAVAR lead, nunca ler.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key
# Chave "service_role" (secreta!). Usada só pelo servidor, pro seu CRM de leads (/admin).
# Nunca coloque ela em arquivo que vai pro GitHub nem mande pra ninguém.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key
# Senha do banco: só pra linha de comando do Supabase (supabase link / db push).
# O site não usa: NÃO cadastre esta na Vercel.
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------
# 3. SEU CRM DE LEADS (/admin)
# ------------------------------------------------------------
# Senha pra entrar no painel em seusite.com/admin. Use uma senha forte (12+ caracteres).
# Vazia = o painel fica trancado.
ADMIN_SENHA=

# ------------------------------------------------------------
# 4. CONVITE NO FINAL DO MATERIAL (opcional)
# ------------------------------------------------------------
# Um bloco verde no material chamando pro próximo passo: uma aula, um grupo, uma consultoria.
# Deixe NEXT_PUBLIC_CONVITE_URL vazio e o bloco não aparece.
# Link do convite (grupo de WhatsApp, página da aula, agenda, formulário...)
NEXT_PUBLIC_CONVITE_URL=
# Etiqueta pequena em cima do título (ex: Aula gratuita e ao vivo)
NEXT_PUBLIC_CONVITE_SELO=Aula gratuita e ao vivo
# Título do convite
NEXT_PUBLIC_CONVITE_TITULO=Vou fazer uma aula ao vivo mostrando isso na prática.
# Uma frase explicando o que fazer
NEXT_PUBLIC_CONVITE_TEXTO=Entra no grupo pra receber o link da aula.
# Texto do botão
NEXT_PUBLIC_CONVITE_BOTAO=Entrar no grupo

# ------------------------------------------------------------
# 5. LGPD — e-mail de contato (aparece na política de privacidade)
# ------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=seu@email.com

# ------------------------------------------------------------
# 6. META PIXEL (opcional) — pra anunciar de novo pra quem visitou
# ------------------------------------------------------------
# Onde pegar: business.facebook.com → Gerenciador de Eventos → Origens de dados
NEXT_PUBLIC_META_PIXEL_ID=
